    "titleBar.inactiveBackground": "#15171b",
    "editorGroupHeader.tabsBackground": "#15171b",
    "tab.activeBackground": "#181a1e",
    "tab.inactiveBackground": "#15171b",
    "tab.border": "#15171b",
    "tab.activeBorderTop": "#82b7a2",
    "panel.background": "#15171b",
    "panel.border": "#25282f",
    "terminal.background": "#15171b",
    "terminal.foreground": "#b9bfc9",
    "input.background": "#1e2127",
    "input.border": "#343a44",
    "input.foreground": "#d5d8df",
    "focusBorder": "#82b7a260",
    "button.background": "#82b7a2",
    "button.foreground": "#101714",
    "button.hoverBackground": "#96c5b2",
    "list.activeSelectionBackground": "#282e35",
    "list.hoverBackground": "#20242a",
    "editor.selectionBackground": "#354b5066",
    "editorWidget.background": "#20242a",
    "editorWidget.border": "#343a44",
