  "tokenColors": [
    { "scope": ["comment"], "settings": { "foreground": "#737e8b" } },
    {
      "scope": ["keyword", "storage"],
      "settings": { "foreground": "#b5a2d1" }
    },
    { "scope": ["string"], "settings": { "foreground": "#a4b995" } },
    {
      "scope": ["entity.name.function", "support.function"],
      "settings": { "foreground": "#94b8ce" }
    },
    {
      "scope": ["constant.numeric", "constant.language"],
      "settings": { "foreground": "#d0b58a" }
    }
  ]
